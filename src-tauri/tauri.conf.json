{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal OS",
  "version": "0.1.1",
  "identifier": "com.personal.os",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Personal OS",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#121a16"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxRTE3MEI5ODYzMUZDMUUKUldRZS9ER0d1WERoWWFVMnQ4bnk4L1c0ZFVnYWs4N0RYcVg0dWU1MEYydlE1aldvT1FWNGM5V3gK",
      "endpoints": [
        "https://github.com/gq8mbtdbtj-hash/pos_pak/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
